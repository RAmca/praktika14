#define _CRT_SECURE_NO_WARNINGS
#include <stdio.h>
#include <stdlib.h>
#include <math.h>
#include <time.h>
#include <locale.h>
#define N 100

double* full_elements(double *ptr_array, int n) {
    int i;
    for (i = 0; i < n; i++) {
        // вещественные числа от -20.00 до 20.00
        ptr_array[i] = (rand() % 4001 - 2000) / 100.0;
    }
    return ptr_array;
}

int put_elements(double *ptr_array, int n) {
    int i;
    for (i = 0; i < n; i++) {
        printf("%4d: %8.2f", i, ptr_array[i]);
        if ((i + 1) % 4 == 0) {
            printf("\n");
        }
    }
    if (n % 4 != 0) {
        printf("\n");
    }
    return n;
}

double* calc_elements(double *ptr_array, int n) {
    int i;
    double *p = ptr_array;
    for (i = 0; i < n; i++) {
        *p = *p * 2;
        p++;
    }
    return ptr_array;
}

double sum_elements(double *ptr_array, int begin, int end) {
    double sum = 0;
    int i;
    for (i = begin; i <= end; i++) {
        sum = sum + ptr_array[i];
    }
    return sum;
}

int find_element(double *ptr_array, int n, double element) {
    int i;
    for (i = 0; i < n; i++) {
        if (fabs(ptr_array[i] - element) < 1e-9) {
            return i;
        }
    }
    return -1;
}

int main() {
    setlocale(LC_ALL, "Russian");
    srand((unsigned)time(NULL));
    double array[N];
    int size;
    int begin, end;
    double element;
    int index;
    printf("Введите размер массива > ");
    scanf("%d", &size);
    if (size <= 0 || size > N) {
        printf("Ошибка: размер должен быть от 1 до %d.\n", N);
        return 1;
    }

    full_elements(array, size);
    printf("\nИсходный массив:\n");
    put_elements(array, size);
    calc_elements(array, size);
    printf("\nМассив после обработки (значения увеличены вдвое):\n");
    put_elements(array, size);

    printf("\nВведите begin и end (индексы от 0 до %d): ", size - 1);
    scanf("%d %d", &begin, &end);

    if (begin < 0 || end >= size || begin > end) {
        printf("Ошибка: неверный диапазон индексов.\n");
    }
    else {
        printf("Сумма элементов с %d по %d: %.2f\n",
               begin, end, sum_elements(array, begin, end));
    }

    printf("\nВведите значение для поиска: ");
    scanf("%lf", &element);
    index = find_element(array, size, element);
    if (index == -1) {
        printf("Элемент %.2f не найден.\n", element);
    }
    else {
        printf("Элемент %.2f найден, его индекс %d.\n", element, index);
    }

    printf("Проверка: элемент %.2f имеет индекс %d\n",
           array[1], find_element(array, size, array[1]));
    return 0;
}
