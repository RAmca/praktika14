#define _CRT_SECURE_NO_WARNINGS
#include <stdio.h>
#include <stdlib.h>
#include <time.h>
#include <locale.h>
#define N 100

double* full_elements(double *ptr_array, int n) {
    int i;
    for (i = 0; i < n; i++) {
        // вещественные числа от -20.00 до 20.00
        ptr_array[i] = (rand() % 4001 - 2000) / 100.0;
    }
    return ptr_array;
}
// печать элементов массива
int put_elements(double *ptr_array, int n) {
    int i;
    for (i = 0; i < n; i++) {
        printf("%4d: %8.2f", i, ptr_array[i]);
        if ((i + 1) % 4 == 0) {
            printf("\n");
        }
    }
    if (n % 4 != 0) {
        printf("\n");
    }
    return n;
}

double* calc_elements(double *ptr_array, int n) {
    int i;
    double *p = ptr_array;
    for (i = 0; i < n; i++) {
        *p = *p * 2;
        p++;
    }
    return ptr_array;
}
int main() {
    setlocale(LC_ALL, "Russian");
    srand((unsigned)time(NULL));
    double array[N];
    int size;
    printf("Введите размер массива > ");
    scanf("%d", &size);
    if (size <= 0 || size > N) {
        printf("Ошибка: размер должен быть от 1 до %d.\n", N);
        return 1;
    }
    full_elements(array, size);
    printf("\nИсходный массив:\n");
    put_elements(array, size);
    calc_elements(array, size);
    printf("\nМассив после обработки (значения увеличены вдвое):\n");
    put_elements(array, size);
    return 0;
}
