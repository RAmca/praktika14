#define _CRT_SECURE_NO_WARNINGS
#include <stdio.h>
#include <stdlib.h>
#include <time.h>
#include <locale.h>
#define N 100

double* full_elements(double *ptr_array, int n) {
    int i;
    for (i = 0; i < n; i++) {
        ptr_array[i] = (rand() % 4001 - 2000) / 100.0;
    }
    return ptr_array;
}

int put_elements(double *ptr_array, int n) {
    int i;
    for (i = 0; i < n; i++) {
        printf("%4d: %8.2f", i, ptr_array[i]);
        if ((i + 1) % 4 == 0) {
            printf("\n");
        }
    }
    if (n % 4 != 0) {
        printf("\n");
    }
    return n;
}

double* calc_elements(double *ptr_array, int n) {
    int i;
    double *p = ptr_array;
    for (i = 0; i < n; i++) {
        *p = *p * 2;
        p++;
    }
    return ptr_array;
}

int count_sign_changes(double *ptr_array, int n) {
    int i;
    int count = 0;
    for (i = 1; i < n; i++) {
        if ((ptr_array[i - 1] < 0 && ptr_array[i] > 0) ||
            (ptr_array[i - 1] > 0 && ptr_array[i] < 0)) {
            count++;
        }
    }
    return count;
}

int main() {
    setlocale(LC_ALL, "Russian");
    srand((unsigned)time(NULL));
    double array[N];
    int size;
    int i;
    int changes;
    printf("Введите размер массива > ");
    scanf("%d", &size);
    if (size <= 0 || size > N) {
        printf("Ошибка: размер должен быть от 1 до %d.\n", N);
        return 1;
    }

    full_elements(array, size);
    printf("\nИсходный массив:\n");
    put_elements(array, size);
    changes = count_sign_changes(array, size);
    printf("\nЧисло изменений знака у соседних элементов: %d\n", changes);

    if (changes > 0) {
        printf("Смена знака происходит между элементами:\n");
        for (i = 1; i < size; i++) {
            if ((array[i - 1] < 0 && array[i] > 0) ||
                (array[i - 1] > 0 && array[i] < 0)) {
                printf("  %d (%.2f) и %d (%.2f)\n", i - 1, array[i - 1], i, array[i]);
            }
        }
    }
    calc_elements(array, size);
    printf("\nМассив после обработки (значения увеличены вдвое):\n");
    put_elements(array, size);
    printf("\nЧисло изменений знака после обработки: %d (знаки не изменились)\n",
           count_sign_changes(array, size));
    return 0;
}
